class EarlyStopping:
    def __init__(self, patience=7, verbose=False, delta=0):
        self.patience = patience
        self.verbose = verbose
        self.counter = 0
        self.best_score = None
        self.early_stop = False
        self.val_loss_min = np.Inf
        self.delta = delta

    def __call__(self, val_loss, model):
        score = -val_loss

        if self.best_score is None:
            self.best_score = score
            self.save_checkpoint(val_loss, model)
        elif score < self.best_score + self.delta:
            self.counter += 1
            if self.verbose:
                logger.info(f'EarlyStopping counter: {self.counter} out of {self.patience}')
            if self.counter >= self.patience:
                self.early_stop = True
        else:
            self.best_score = score
            self.save_checkpoint(val_loss, model)
            self.counter = 0

    def save_checkpoint(self, val_loss, model):
        if self.verbose:
            logger.info(f'Validation loss decreased ({self.val_loss_min:.6f} --> {val_loss:.6f}). Saving model ...')
        torch.save(model.state_dict(), 'checkpoint.pt')
        self.val_loss_min = val_loss


class KANLinear(nn.Module):
    def __init__(self, in_features, out_features, num_knots=10, degree=3):
        super(KANLinear, self).__init__()
        self.in_features = in_features
        self.out_features = out_features
        self.num_knots = num_knots
        self.degree = degree

        assert self.num_knots >= self.degree + 2, "Number of knots must be at least degree + 2"

        num_basis = self.num_knots - self.degree - 1
        self.weight = nn.Parameter(torch.Tensor(out_features, in_features))
        self.bias = nn.Parameter(torch.Tensor(out_features))
        self.coefficients = nn.Parameter(torch.Tensor(in_features, num_basis, out_features))

        # B 样条节点
        self.register_buffer('knots', torch.linspace(0, 1, num_knots))

        self.reset_parameters()

    def reset_parameters(self):
        nn.init.kaiming_uniform_(self.weight, a=1.414)
        nn.init.kaiming_uniform_(self.coefficients, a=1.414)
        nn.init.zeros_(self.bias)

    def compute_b_spline_basis(self, x):
        device = x.device
        knots = self.knots.to(device)
        x = x.unsqueeze(-1)  # [batch_size, in_features, 1]

        num_knots = len(knots)
        degree = self.degree
        num_basis = num_knots - degree - 1  # number of basis functions

        # 初始化 0 次 B 样条基函数
        N = ((x >= knots[:-1]) & (x < knots[1:])).float()  # [batch_size, in_features, num_knots - 1]

        for d in range(1, degree + 1):
            denom1 = (knots[d:-1] - knots[:-d - 1] + 1e-8).unsqueeze(0).unsqueeze(0)
            denom2 = (knots[d + 1:] - knots[1:-d] + 1e-8).unsqueeze(0).unsqueeze(0)

            term1 = ((x - knots[:-d - 1]) / denom1) * N[..., :-1]
            term2 = ((knots[d + 1:] - x) / denom2) * N[..., 1:]

            N = term1 + term2  # [batch_size, in_features, num_knots - d - 1]

        basis = N  # [batch_size, in_features, num_basis]
        return basis

    def forward(self, x):
        # 基本线性变换
        base_output = F.linear(x, self.weight, self.bias)  # 形状：[batch_size, out_features]

        # 输入归一化
        x_min = x.min(dim=0, keepdim=True)[0]
        x_max = x.max(dim=0, keepdim=True)[0]
        x_normalized = (x - x_min) / (x_max - x_min + 1e-8)

        # 计算 B 样条基函数
        basis = self.compute_b_spline_basis(x_normalized)  # 形状：[batch_size, in_features, num_basis]

        # 计算样条输出
        coefficients = self.coefficients.unsqueeze(0)  # 形状：[1, in_features, num_basis, out_features]
        basis = basis.unsqueeze(-1)  # 形状：[batch_size, in_features, num_basis, 1]

        spline_output = (basis * coefficients).sum(dim=2)  # 形状：[batch_size, in_features, out_features]
        spline_output = spline_output.sum(dim=1)  # 形状：[batch_size, out_features]

        # 最终输出
        output = base_output + spline_output
        return output


class TransKAN(nn.Module):
    def __init__(self, input_dim, hidden_dim=128, num_layers=3, dropout=0.1):
        super(TransKAN, self).__init__()
        layers = []
        layers.append(KANLinear(input_dim, hidden_dim))
        layers.append(nn.ReLU())
        layers.append(nn.BatchNorm1d(hidden_dim))
        layers.append(nn.Dropout(dropout))

        for _ in range(num_layers - 2):
            layers.append(KANLinear(hidden_dim, hidden_dim))
            layers.append(nn.ReLU())
            layers.append(nn.BatchNorm1d(hidden_dim))
            layers.append(nn.Dropout(dropout))

        layers.append(KANLinear(hidden_dim, 1))
        layers.append(nn.Sigmoid())

        self.model = nn.Sequential(*layers)

    def forward(self, x):
        return self.model(x)

    def fit(self, X, y, X_val, y_val, epochs=100, batch_size=32, learning_rate=0.001, patience=10):
        criterion = nn.BCELoss()
        optimizer = optim.Adam(self.parameters(), lr=learning_rate)

        # 确保 y 和 y_val 是 pandas Series
        if not isinstance(y, pd.Series):
            y = pd.Series(y)
        if not isinstance(y_val, pd.Series):
            y_val = pd.Series(y_val)

        # 将标签转换为数值类型
        y_numeric = (y == 'BBB+').astype(float)
        y_val_numeric = (y_val == 'BBB+').astype(float)

        X_tensor = torch.FloatTensor(X.values)
        y_tensor = torch.FloatTensor(y_numeric.values).unsqueeze(1)
        dataset = TensorDataset(X_tensor, y_tensor)
        dataloader = DataLoader(dataset, batch_size=batch_size, shuffle=True)

        X_val_tensor = torch.FloatTensor(X_val.values)
        y_val_tensor = torch.FloatTensor(y_val_numeric.values).unsqueeze(1)

        best_val_auc = 0
        best_model_state = None
        best_epoch = 0
        no_improve = 0

        for epoch in range(epochs):
            self.train()
            train_loss = 0.0
            for batch_X, batch_y in dataloader:
                optimizer.zero_grad()
                outputs = self(batch_X)
                loss = criterion(outputs, batch_y)
                loss.backward()
                optimizer.step()
                train_loss += loss.item()

            train_loss /= len(dataloader)

            self.eval()
            with torch.no_grad():
                val_outputs = self(X_val_tensor)
                val_loss = criterion(val_outputs, y_val_tensor)

            train_metrics = evaluate_model(self, X, y)
            val_metrics = evaluate_model(self, X_val, y_val)

            logger.info(f'Epoch [{epoch+1}/{epochs}]')
            logger.info(f'  Train Loss: {train_loss:.4f}, Val Loss: {val_loss:.4f}')
            logger.info(f'  Train Metrics: {train_metrics}')
            logger.info(f'  Val Metrics: {val_metrics}')

            # 检查是否是最佳模型
            if val_metrics['auc'] > best_val_auc:
                best_val_auc = val_metrics['auc']
                best_model_state = self.state_dict()
                best_epoch = epoch + 1
                no_improve = 0
                torch.save(best_model_state, './models/transkan_bspline/best_model.pt')
                logger.info(f'New best model saved with validation AUC: {best_val_auc:.4f}')
            else:
                no_improve += 1

            # 早停检查
            if no_improve >= patience:
                logger.info(f'Early stopping triggered. Best epoch: {best_epoch}')
                break

        # 训练结束后，加载最佳模型
        self.load_state_dict(torch.load('./models/transkan_bspline/best_model.pt'))
        logger.info(f'Best epoch: {best_epoch} with validation AUC: {best_val_auc:.4f}')

    def predict(self, X):
        self.eval()
        with torch.no_grad():
            X_tensor = torch.FloatTensor(X.values)
            outputs = self(X_tensor)
            predictions = (outputs > 0.5).float().numpy().flatten()
        return np.where(predictions == 1, 'BBB+', 'BBB-')

    def predict_proba(self, X):
        self.eval()
        with torch.no_grad():
            X_tensor = torch.FloatTensor(X.values)
            outputs = self(X_tensor).numpy()
        return np.column_stack((1 - outputs, outputs))


def augment_smiles(smiles, num_augments):
    return [smiles] * num_augments


def preprocess_and_augment_bbb_data(data_filename, smile_col_name='SMILE', label_col_name='BBB+/BBB-', augment_factor=2,
                                    feature_cols=None):
    data = pd.read_csv(data_filename)
    Y = data[label_col_name]
    SMILES = data[smile_col_name]

    if feature_cols is None:
        X = data.drop(columns=[smile_col_name, label_col_name])
    else:
        X = data[feature_cols]

    logger.info("原始特征：")
    logger.info(X.head())

    logger.info("原始数据的BBB+/BBB-分布：")
    logger.info(Y.value_counts())

    augmented_X, augmented_Y, augmented_SMILES = [], [], []
    for smiles, x, y in tqdm(zip(SMILES, X.values, Y), total=len(SMILES), desc="Augmenting data"):
        augmented_SMILES.append(smiles)
        augmented_X.append(x)
        augmented_Y.append(y)

        augmented_smiles = augment_smiles(smiles, num_augments=augment_factor)
        for aug_smiles in augmented_smiles:
            augmented_SMILES.append(aug_smiles)
            augmented_X.append(x)
            augmented_Y.append(y)

    augmented_X = pd.DataFrame(augmented_X, columns=X.columns)
    augmented_Y = pd.Series(augmented_Y)

    logger.info(f"增强后的数据量: {len(augmented_X)}")

    logger.info("增强后数据BBB+/BBB-分布：")
    logger.info(augmented_Y.value_counts())

    return augmented_X, augmented_Y, augmented_SMILES


def resample(X, y, strategy='auto', random_state=None):
    smote = SMOTE(sampling_strategy=strategy, random_state=random_state)
    X_resampled, y_resampled = smote.fit_resample(X, y)
    logger.info(f"重采样后的数据量: {len(X_resampled)}")

    logger.info("重采样后数据的BBB+/BBB-分布：")
    logger.info(pd.Series(y_resampled).value_counts())

    return X_resampled, y_resampled


def objective(trial, X_train, y_train, X_val, y_val):
    config = {
        "hidden_dim": trial.suggest_categorical("hidden_dim", [32, 64, 128]),
        "num_layers": trial.suggest_int("num_layers", 2, 4),
        "dropout": trial.suggest_float("dropout", 0.1, 0.5),
        "lr": trial.suggest_loguniform("lr", 1e-4, 1e-1),
        "batch_size": trial.suggest_categorical("batch_size", [16, 32, 64]),
        "epochs": trial.suggest_categorical("epochs", [50, 100, 200]),
        "random_seed": trial.suggest_int("random_seed", 0, 100000)
    }

    model = TransKAN(
        input_dim=X_train.shape[1],
        hidden_dim=config["hidden_dim"],
        num_layers=config["num_layers"],
        dropout=config["dropout"]
    )
    model.fit(X_train, y_train, X_val, y_val, epochs=config["epochs"], batch_size=config["batch_size"],
              learning_rate=config["lr"])

    y_pred = model.predict(X_val)
    accuracy = accuracy_score(y_val, y_pred)

    return accuracy


def optimize_hyperparameters(X_train, y_train, X_val, y_val, n_trials=100):
    study = optuna.create_study(direction="maximize")
    study.optimize(lambda trial: objective(trial, X_train, y_train, X_val, y_val), n_trials=n_trials)

    logger.info("Best trial:")
    trial = study.best_trial

    logger.info("  Value: {}".format(trial.value))
    logger.info("  Params: ")
    for key, value in trial.params.items():
        logger.info("    {}: {}".format(key, value))

    with open('best_params.json', 'w') as f:
        json.dump(trial.params, f)

    return trial.params


def load_best_params():
    if os.path.exists('best_params.json'):
        with open('best_params.json', 'r') as f:
            return json.load(f)
    return None


def evaluate_model(model, X, y):
    y_pred = model.predict(X)
    y_pred_proba = model.predict_proba(X)[:, 1]

    accuracy = accuracy_score(y, y_pred)
    precision = precision_score(y, y_pred, pos_label='BBB+')
    recall = recall_score(y, y_pred, pos_label='BBB+')
    f1 = f1_score(y, y_pred, pos_label='BBB+')
    auc = roc_auc_score(y == 'BBB+', y_pred_proba)

    return {
        'accuracy': accuracy,
        'precision': precision,
        'recall': recall,
        'f1': f1,
        'auc': auc
    }


def run_experiment(data_file, smile_col='SMILES', label_col='BBB+/BBB-', augment_factor=2, resample_strategy='auto'):
    X, y, SMILES = preprocess_and_augment_bbb_data(data_file,
                                                   smile_col_name=smile_col,
                                                   label_col_name=label_col,
                                                   augment_factor=augment_factor)

    X_train_val, X_test, y_train_val, y_test = train_test_split(X, y, test_size=0.2, random_state=46028,
                                                                stratify=y)

    skf = StratifiedKFold(n_splits=10, shuffle=True, random_state=46028)

    fold_results = []
    best_fold_model = None
    best_fold_auc = 0

    for fold, (train_index, val_index) in enumerate(skf.split(X_train_val, y_train_val), 1):
        logger.info(f"Fold {fold}")

        X_train, X_val = X_train_val.iloc[train_index], X_train_val.iloc[val_index]
        y_train, y_val = y_train_val.iloc[train_index], y_train_val.iloc[val_index]

        X_resampled, y_resampled = resample(X_train, y_train, strategy=resample_strategy)

        model = TransKAN(
            input_dim=X_resampled.shape[1],
            hidden_dim=128,
            num_layers=3,
            dropout=0.1
        )

        model.fit(X_resampled, y_resampled, X_val, y_val, epochs=100, batch_size=32, learning_rate=0.001, patience=10)

        metrics = evaluate_model(model, X_val, y_val)
        fold_results.append(metrics)

        logger.info(f"Fold {fold} Results:")
        for metric, value in metrics.items():
            logger.info(f"  {metric.capitalize()}:  {value:.4f}")

        # 保存最佳表现的模型
        if metrics['auc'] > best_fold_auc:
            best_fold_auc = metrics['auc']
            best_fold_model = model
            torch.save(model.state_dict(), f'./models/transkan_bspline/best_fold_model.pt')
            logger.info(f"新的最佳模型已保存 (折 {fold}, AUC: {best_fold_auc:.4f})")

    avg_metrics = {metric: np.mean([fold[metric] for fold in fold_results]) for metric in fold_results[0]}
    std_metrics = {metric: np.std([fold[metric] for fold in fold_results]) for metric in fold_results[0]}

    logger.info("Cross-validation Results:")
    for metric in avg_metrics:
        logger.info(f"  {metric.capitalize()}:  {avg_metrics[metric]:.4f} (+/- {std_metrics[metric]:.4f})")

    X_resampled, y_resampled = resample(X_train_val, y_train_val, strategy=resample_strategy)
    final_model = TransKAN(
        input_dim=X_resampled.shape[1],
        hidden_dim=128,
        num_layers=3,
        dropout=0.1
    )
    final_model.load_state_dict(torch.load('./models/transkan_bspline/best_fold_model.pt'))
    final_model.fit(X_resampled, y_resampled, X_resampled, y_resampled, epochs=200,
                    batch_size=32, learning_rate=0.001)

    test_metrics = evaluate_model(final_model, X_test, y_test)
    logger.info("Test Set Results:")
    for metric, value in test_metrics.items():
        logger.info(f"  {metric.capitalize()}:  {value:.4f}")

    torch.save(final_model.state_dict(), './models/transkan_bspline/final_model.pt')
    logger.info("Final model saved to './models/transkan_bspline/final_model.pt'")

    return final_model, test_metrics


if __name__ == "__main__":
    # 确保模型保存目存在
    os.makedirs('./models/transkan_bspline', exist_ok=True)

    data_file = './data/b3db_fused_features64d.csv'
    model, metrics = run_experiment(data_file)
    print("最终测试指标:", metrics)

